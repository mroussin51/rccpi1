{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "Migrate a website to AWS with minimal downtime",
  "description": "A staged cutover using temporary hostname validation and low DNS TTL.",
  "totalTime": "PT4H",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Export site",
      "text": "Export files and database. Freeze edits."
    },
    {
      "@type": "HowToStep",
      "name": "Provision target",
      "text": "Create EC2/Lightsail or ECS/EKS environment and harden it."
    },
    {
      "@type": "HowToStep",
      "name": "Import & validate",
      "text": "Import data and test behind a temporary hostname."
    },
    {
      "@type": "HowToStep",
      "name": "Lower TTL & cut over",
      "text": "Set DNS TTL to ~300s. Switch DNS during low traffic."
    },
    {
      "@type": "HowToStep",
      "name": "Monitor & rollback",
      "text": "Watch logs/metrics; revert DNS if errors spike."
    }
  ]
